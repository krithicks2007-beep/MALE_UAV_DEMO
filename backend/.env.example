# ============================================================
# MALE UAV Backend — Environment Variables
# ============================================================
# Copy this file to `.env` (gitignored) and set real values.

# CORS: comma-separated list of allowed frontend origins.
# Leave as * for development (allows all origins).
# For production, set to your specific frontend domain(s):
# ALLOWED_ORIGINS=https://your-dashboard.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=*

# Server settings (override uvicorn defaults)
HOST=0.0.0.0
PORT=8000
