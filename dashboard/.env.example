# ============================================================
# MALE UAV Dashboard — Frontend Environment Variables
# ============================================================
# Copy this file to `.env` (gitignored) and set real values.
# All VITE_ prefixed vars are injected at build time by Vite.

# WebSocket URL for live telemetry stream
# Local dev:        ws://localhost:8000/ws/telemetry
# Production:       wss://your-backend.railway.app/ws/telemetry
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/telemetry

# REST API base URL (used by any future REST fetch calls)
# Local dev:        http://localhost:8000
# Production:       https://your-backend.railway.app
VITE_BACKEND_API_URL=http://localhost:8000
